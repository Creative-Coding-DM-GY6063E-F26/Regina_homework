let bDoExportSvg = false;

function rectangle(x0, y0, w, h) {
    rectMode(CENTER);
    rect(x0, y0, w, h);
}
  
function setup() {
  createCanvas(windowWidth, windowHeight);
  noLoop();
}

function keyPressed() {
    if (key == 's' || key == 'S') {
        bDoExportSvg = true;
        redraw();
    }
}

function draw() {
    // start SVG recording

    if(bDoExportSvg) {
        beginRecordSvg(
            this,
            "retangle_loop.svg"
        );
    }
    
  background(80, 80, 120);

  noFill();
  stroke(250, 190, 0);
  strokeWeight(10);

  for (let y = 50; y < height; y += 50) {
    for (let x = 50; x < width; x += 50) {
      rectangle(x, y, 8, 40);
      rectangle(80, 8,40,9);
    }
  }


//Finsh SVG recording
if(bDoExportSvg) {
    endRecordSvg();
    bDoExportSvg = false;
}
}